{"schema_version": "2.0", "record_type": "finance_news_article", "article_id": "4beeced70bc389b9e8366d3e", "title": "亿客行CEO：AI智能代理尚未改变用户预订习惯", "url": "https://finance.sina.com.cn/stock/usstock/c/2026-11-06/doc-inixthph8598722.shtml", "source": "新浪财经", "source_id": "sina_finance", "source_tier": "T1", "published_at": "2026-11-06T00:14:49+08:00", "crawled_at": "2026-11-06T00:36:20.727367+08:00", "status": "valid", "quality_score": 0.976, "quality_flags": [], "hotness": {"score": 81.734, "list_rank": 4, "list_size": 192, "rank_percentile": 0.9844, "source_priority": 6, "source_tier": "T1", "has_engagement_metrics": true, "engagement_score": 0.0}, "engagement": {"has_any_metric": true, "available_metrics": ["comment_count"], "missing_metrics": ["read_count", "view_count", "like_count", "favorite_count", "share_count", "repost_count"], "available_metric_count": 1, "counts": {"read_count": null, "view_count": null, "comment_count": 0, "like_count": null, "favorite_count": null, "share_count": null, "repost_count": null}, "score": 0.0, "metric_source": "sina_finance_detail_html+sina_comment_api", "collected_at": "2026-11-06T00:36:20.727367+08:00", "quality_flags": [], "raw": {"sina_comment_api": {"sina_comment_count": {"total": 0, "show": 0, "thread_show": 0, "qreply_show": 0, "qreply": 0}, "api_url": "https://comment5.news.sina.com.cn/cmnt/count?format=json&newslist=cj%3Acomos-nixthph8598722", "comment_channel": "cj", "comment_id": "comos-nixthph8598722"}}}, "source_info": {"id": "sina_finance", "name": "新浪财经", "tier": "T1", "role": "market_news", "priority": 6, "section": "滚动新闻"}, "time_info": {"published_at": "2026-11-06T00:14:49+08:00", "published_date": "2026-11-06", "crawled_at": "2026-11-06T00:36:20.727367+08:00", "crawl_date": "2026-11-06", "timezone": "Asia/Shanghai", "age_minutes_at_crawl": 21.53, "published_after_crawl": false}, "content_info": {"title_length": 23, "content_length": 818, "has_content": true, "excerpt": "核心要点 亿客行（Expedia）首席执行官 阿里 亚娜・戈林表示，公司暂未观察到 AI 智能代理改变消费者的预订行为。 她称，旅游业业务错综复杂，AI 很难完全替代旅游服务。 该公司公布的第四季度业绩指引低于分析师预期。 亿客行 CEO 阿里亚娜・戈林周四表示，目前还没有看到 AI 智能代理改变用户的预订方式，但早期迹象显示该技术存在带动行业变革的潜力。 “AI 很适合用来获取旅行灵感、规划行程，” 戈林在采访中说道，“但我们尚未看到它改变用户实际下单预订的行为。” 当下，", "author": "环球市场播报", "keywords": []}, "extraction": {"entrypoint_url": "https://finance.sina.com.cn/roll/", "raw_html_path": null, "list_rank": 4, "list_size": 192, "captured_at": "2026-11-06T00:36:20.727367+08:00", "method": "滚动新闻"}, "quality": {"status": "valid", "score": 0.976, "grade": "A", "flags": [], "review_required": false, "downstream_usable": true}, "content": "核心要点 亿客行（Expedia）首席执行官 阿里 亚娜・戈林表示，公司暂未观察到 AI 智能代理改变消费者的预订行为。 她称，旅游业业务错综复杂，AI 很难完全替代旅游服务。 该公司公布的第四季度业绩指引低于分析师预期。 亿客行 CEO 阿里亚娜・戈林周四表示，目前还没有看到 AI 智能代理改变用户的预订方式，但早期迹象显示该技术存在带动行业变革的潜力。 “AI 很适合用来获取旅行灵感、规划行程，” 戈林在采访中说道，“但我们尚未看到它改变用户实际下单预订的行为。” 当下，Meta 的 Muse、OpenAI 的 Dots 这类个人 AI 智能代理逐步走入大众视野，号称可以帮普通美国人处理从日程安排到购物的各类事务。AI 在旅行规划、预订领域的应用潜力，可能会对亿客行这类传统旅游平台构成竞争威胁。 戈林称，亿客行正在 “对接各类 AI 智能代理”，确保自家产品能够出现在 AI 的返回结果中；研究 AI 获取信息的逻辑，完成必要的系统对接集成。 她承认，AI 代理未来有可能打造自有旅游服务体系、抢夺市场份额。但旅游业本身存在诸多复杂环节，例如客户服务，很难完全依靠人工智能替代。 “消费者本来就会多方比价，AI 代理只是把这件事变得更简单。但真正到预订环节：你需要确认信息准确无误、配套服务属实、价格真实有效；一旦出问题，得有人帮你解决、接起电话提供支持。这些事情目前 AI 代理还做不到，这也是用户信任并选择亿客行的原因。” 亿客行周三盘后公布财报后，周四股价下跌约 12%。公司预计今年第四季度营收区间 36.9‑37.5 亿美元，FactSet 数据显示，该区间中点低于分析师 37.4 亿美元的一致预期。 戈林将第四季度指引 “增长放缓” 归因于 “中东与欧洲地缘事件”、中期选举，以及公司把秋季大促从第四季度调整至第三季度。但她同时提到，公司第三季度财报表现亮眼，总预订交易额同比上涨 11%，营收增长 12%。", "author": "环球市场播报", "section": "滚动新闻", "keywords": [], "hot_features": {"source_prominence": {"list_rank": 4, "list_size": 192, "source_priority": 6, "source_tier": "T1", "entrypoint": "https://finance.sina.com.cn/roll/", "captured_at": "2026-11-06T00:36:20.727367+08:00"}, "engagement_metrics": {"read_count": null, "view_count": null, "comment_count": 0, "like_count": null, "favorite_count": null, "share_count": null, "repost_count": null, "collected_at": "2026-11-06T00:36:20.727367+08:00", "source": "sina_finance_detail_html+sina_comment_api", "available_fields": ["comment_count"], "missing_fields": ["read_count", "view_count", "like_count", "favorite_count", "share_count", "repost_count"], "quality_flags": [], "raw": {"sina_comment_api": {"sina_comment_count": {"total": 0, "show": 0, "thread_show": 0, "qreply_show": 0, "qreply": 0}, "api_url": "https://comment5.news.sina.com.cn/cmnt/count?format=json&newslist=cj%3Acomos-nixthph8598722", "comment_channel": "cj", "comment_id": "comos-nixthph8598722"}}}}, "diagnostics": {"content_hash": "02a59ca9212023908c69e0bff94a8dcfab50181e9eb8e04edbebd1d34bcd30b8", "title_hash": "109009bfdaf9ea5ec39f7af4a07bdb1f068b38795df9a108da8d4d7fb7f1389e", "quality_flags": []}, "content_hash": "02a59ca9212023908c69e0bff94a8dcfab50181e9eb8e04edbebd1d34bcd30b8", "title_hash": "109009bfdaf9ea5ec39f7af4a07bdb1f068b38795df9a108da8d4d7fb7f1389e", "raw_html_path": null, "fetch_entrypoint": "https://finance.sina.com.cn/roll/"}
