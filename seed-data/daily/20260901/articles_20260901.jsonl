{"schema_version": "2.0", "record_type": "finance_news_article", "article_id": "9bdd2b384c47dea4ee5a67dc", "title": "Kalshi平台因非法交易永久封禁前共和党众议员乔治・桑托斯", "url": "https://finance.sina.com.cn/stock/usstock/c/2026-09-01/doc-iniqfuyq1666678.shtml", "source": "新浪财经", "source_id": "sina_finance", "source_tier": "T1", "published_at": "2026-09-01T00:10:10+08:00", "crawled_at": "2026-09-01T00:14:23.442032+08:00", "status": "valid", "quality_score": 0.976, "quality_flags": [], "hotness": {"score": 82.28, "list_rank": 1, "list_size": 199, "rank_percentile": 1.0, "source_priority": 6, "source_tier": "T1", "has_engagement_metrics": true, "engagement_score": 0.0}, "engagement": {"has_any_metric": true, "available_metrics": ["comment_count"], "missing_metrics": ["read_count", "view_count", "like_count", "favorite_count", "share_count", "repost_count"], "available_metric_count": 1, "counts": {"read_count": null, "view_count": null, "comment_count": 0, "like_count": null, "favorite_count": null, "share_count": null, "repost_count": null}, "score": 0.0, "metric_source": "sina_finance_detail_html+sina_comment_api", "collected_at": "2026-09-01T00:14:23.442032+08:00", "quality_flags": [], "raw": {"sina_comment_api": {"sina_comment_count": {"total": 0, "show": 0, "thread_show": 0, "qreply_show": 0, "qreply": 0}, "api_url": "https://comment5.news.sina.com.cn/cmnt/count?format=json&newslist=cj%3Acomos-niqfuyq1666678", "comment_channel": "cj", "comment_id": "comos-niqfuyq1666678"}}}, "source_info": {"id": "sina_finance", "name": "新浪财经", "tier": "T1", "role": "market_news", "priority": 6, "section": "滚动新闻"}, "time_info": {"published_at": "2026-09-01T00:10:10+08:00", "published_date": "2026-09-01", "crawled_at": "2026-09-01T00:14:23.442032+08:00", "crawl_date": "2026-09-01", "timezone": "Asia/Shanghai", "age_minutes_at_crawl": 4.22, "published_after_crawl": false}, "content_info": {"title_length": 30, "content_length": 279, "has_content": true, "excerpt": "核心要点 预测交易平台 Kalshi 对前共和党众议员乔治・桑托斯处以 终身封禁 ，缘由是他涉嫌押注自己是否会出席本年度国情咨文演讲。 此前，美国商品期货交易委员会（CFTC）已经就这起国情咨文出席情况的押注案件对桑托斯处以罚款。 桑托斯于 2023 年被逐出众议院；他曾因电信欺诈、严重身份盗窃罪被判处 87 个月监禁，不过特朗普总统去年为他减刑。 桑托斯在社交平台 X 上强硬回怼，质疑 Kalshi 这家平台本身还能运营多久。 被逐出美国众议院的乔治・桑托斯，2025 年 ", "author": "环球市场播报", "keywords": []}, "extraction": {"entrypoint_url": "https://finance.sina.com.cn/roll/", "raw_html_path": null, "list_rank": 1, "list_size": 199, "captured_at": "2026-09-01T00:14:23.442032+08:00", "method": "滚动新闻"}, "quality": {"status": "valid", "score": 0.976, "grade": "A", "flags": [], "review_required": false, "downstream_usable": true}, "content": "核心要点 预测交易平台 Kalshi 对前共和党众议员乔治・桑托斯处以 终身封禁 ，缘由是他涉嫌押注自己是否会出席本年度国情咨文演讲。 此前，美国商品期货交易委员会（CFTC）已经就这起国情咨文出席情况的押注案件对桑托斯处以罚款。 桑托斯于 2023 年被逐出众议院；他曾因电信欺诈、严重身份盗窃罪被判处 87 个月监禁，不过特朗普总统去年为他减刑。 桑托斯在社交平台 X 上强硬回怼，质疑 Kalshi 这家平台本身还能运营多久。 被逐出美国众议院的乔治・桑托斯，2025 年 4 月 25 日现身纽约中央艾斯利普联邦法院，出席自身腐败刑事案件量刑听证会。", "author": "环球市场播报", "section": "滚动新闻", "keywords": [], "hot_features": {"source_prominence": {"list_rank": 1, "list_size": 199, "source_priority": 6, "source_tier": "T1", "entrypoint": "https://finance.sina.com.cn/roll/", "captured_at": "2026-09-01T00:14:23.442032+08:00"}, "engagement_metrics": {"read_count": null, "view_count": null, "comment_count": 0, "like_count": null, "favorite_count": null, "share_count": null, "repost_count": null, "collected_at": "2026-09-01T00:14:23.442032+08:00", "source": "sina_finance_detail_html+sina_comment_api", "available_fields": ["comment_count"], "missing_fields": ["read_count", "view_count", "like_count", "favorite_count", "share_count", "repost_count"], "quality_flags": [], "raw": {"sina_comment_api": {"sina_comment_count": {"total": 0, "show": 0, "thread_show": 0, "qreply_show": 0, "qreply": 0}, "api_url": "https://comment5.news.sina.com.cn/cmnt/count?format=json&newslist=cj%3Acomos-niqfuyq1666678", "comment_channel": "cj", "comment_id": "comos-niqfuyq1666678"}}}}, "diagnostics": {"content_hash": "5a49ed4b63985fb281cb92b5449948041eb60a9a56f28d66252dfe283bc5c8e4", "title_hash": "4fc271